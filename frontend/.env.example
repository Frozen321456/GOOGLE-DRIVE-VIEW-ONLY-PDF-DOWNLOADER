# Frontend environment (set these in Vercel: Settings > Environment Variables)
# Firebase web config — Firebase console > Project settings > Your apps > Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Render backend base URL, no trailing slash
VITE_BACKEND_URL=
#
# How they reach the site: Vercel runs `node scripts/gen-env.mjs` at build
# time (see vercel.json buildCommand), which bakes them into env.js as
# window.__ENV__. For local dev, either run the same script or edit env.js
# directly (it is committed as an empty placeholder).
